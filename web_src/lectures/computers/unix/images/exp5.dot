digraph finite_state_machine {
	rankdir=LR;
        {
		node [style = invis]; I;
	}
	node [shape = doublecircle]; 5;
	node [shape = circle];
        I -> 0
	0 -> 1 [ label = "T" ];
	1 -> 2 [ label = "T" ];
	2 -> 3 [ label = "A" ];
	3 -> 3 [ label = "A" ];
	3 -> 4 [ label = "T" ];
	4 -> 5 [ label = "T" ];

}
